# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/database"

# ============================================
# REDIS (Queue & Caching)
# ============================================
REDIS_URL="redis://default:password@host:6379"

# ============================================
# CLOUDFLARE R2 (S3-Compatible Storage)
# ============================================
R2_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"

# ============================================
# SUPABASE AUTHENTICATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================
# EXTERNAL APIs (SERVER-SIDE ONLY - NEVER EXPOSE)
# ============================================

# ScrapingDog - Google Scholar Search
SCRAPINGDOG_API_KEY="your-scrapingdog-key"

# Groq API Keys (for AI analysis) - supports multiple keys for rate limiting
GROQ_API_KEY="your-groq-key"
GROQ_API_KEY_1="your-groq-key-1"
GROQ_API_KEY_2="your-groq-key-2"
GROQ_API_KEY_3="your-groq-key-3"
GROQ_API_KEY_4="your-groq-key-4"
GROQ_API_KEY_5="your-groq-key-5"

# Google Gemini API Keys (fallback for AI analysis)
GEMINI_API_KEY="your-gemini-key"
GEMINI_API_KEY_1="your-gemini-key-1"
GEMINI_API_KEY_2="your-gemini-key-2"
GEMINI_API_KEY_3="your-gemini-key-3"

# Unpaywall API (academic paper access)
UNPAYWALL_EMAIL="your-email@example.com"

# ============================================
# PADDLE PAYMENT INTEGRATION
# ============================================
# Paddle API Key (Server-side)
PADDLE_API_KEY="pdl_sdbx_apikey_your-key-here"

# Paddle Client Token (Client-side - safe to expose)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_your-token-here"

# Paddle Seller ID
NEXT_PUBLIC_PADDLE_SELLER_ID="12345"

# Paddle Product Price IDs
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID="pri_monthly_id"
NEXT_PUBLIC_PADDLE_YEARLY_PRICE_ID="pri_yearly_id"

# Paddle Webhook Secret (for signature verification)
PADDLE_WEBHOOK_SECRET="ntfset_your-webhook-secret"

# Paddle Environment (sandbox or production)
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# ============================================
# DEPLOYMENT
# ============================================
NODE_ENV="production"

# ============================================
# SECURITY NOTES
# ============================================
# ⚠️ NEVER commit this file with real values to git!
# ⚠️ Only use NEXT_PUBLIC_ prefix for client-safe values
# ⚠️ All API keys above are server-side only and hidden from client
# ⚠️ Rate limiting is enforced on all API endpoints
