generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PENDING
  SEARCHING
  DOWNLOADING
  ANALYZING
  COMPLETED
  FAILED
  STOPPED
}

enum ExtractionStatus {
  PENDING
  ABSTRACT_ONLY
  COMPLETED
  FAILED
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  email     String
  name      String?
  avatarUrl String?  @map("avatar_url")
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("profiles")
}

model Project {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  topic           String
  yearFrom        Int           @map("year_from")
  yearTo          Int           @map("year_to")
  maxPapers       Int           @default(100) @map("max_papers")
  status          ProjectStatus @default(PENDING)
  totalPapers     Int           @default(0) @map("total_papers")
  processedPapers Int           @default(0) @map("processed_papers")
  failedPapers    Int           @default(0) @map("failed_papers")
  errorMessage    String?       @map("error_message")
  jobId           String?       @map("job_id")
  stopRequested   Boolean       @default(false) @map("stop_requested")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  profile       Profile        @relation(fields: [userId], references: [userId])
  projectPapers ProjectPaper[]

  @@map("projects")
}

model Paper {
  id            String   @id @default(uuid())
  doi           String?  @unique
  title         String
  authors       Json     @default("[]")
  year          Int?
  journal       String?
  abstract      String?
  citationCount Int?     @map("citation_count")
  isOpenAccess  Boolean  @default(false) @map("is_open_access")
  pdfUrl        String?  @map("pdf_url")
  s3Key         String?  @map("s3_key")
  quartile      String?
  sourceApi     String?  @map("source_api")
  externalIds   Json     @default("{}") @map("external_ids")
  createdAt     DateTime @default(now()) @map("created_at")

  projectPapers ProjectPaper[]
  extraction    Extraction?

  @@map("papers")
}

model ProjectPaper {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  paperId          String           @map("paper_id")
  extractionStatus ExtractionStatus @default(PENDING) @map("extraction_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paper   Paper   @relation(fields: [paperId], references: [id])

  @@unique([projectId, paperId])
  @@map("project_papers")
}

model Extraction {
  id               String   @id @default(uuid())
  paperId          String   @unique @map("paper_id")
  methodology      String?
  findings         String?
  limitations      String?
  futureWork       String?  @map("future_work")
  studyType        String?  @map("study_type")
  keywords         Json     @default("[]")
  rawJson          Json?    @map("raw_json")
  model            String?
  isAbstractOnly   Boolean  @default(false) @map("is_abstract_only")
  extractedAt      DateTime @default(now()) @map("extracted_at")

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("extractions")
}
